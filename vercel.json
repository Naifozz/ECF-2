{
  "version": 2,
  "builds": [
    {
      "src": "frontend/public/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/", "dest": "/frontend/public/pages/items.html" },
    { "src": "/items", "dest": "/frontend/public/pages/items.html" },
    { "src": "/recipes", "dest": "/frontend/public/pages/recipes.html" },
    { "src": "/register", "dest": "/frontend/public/pages/register.html" },
    { "src": "/login", "dest": "/frontend/public/pages/login.html" }
  ]
}
